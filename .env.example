# =============================================================================
# LMTrade configuration — copy to .env and fill in.  Nothing here is committed.
# All values are optional: the bot runs in paper mode with synthetic data and a
# heuristic model if no keys are provided.
# =============================================================================

# ---- Trading mode -----------------------------------------------------------
# paper  = simulated broker (default, safe)
# live   = real Trade Republic execution via the unofficial pytr API (opt-in!)
LMTRADE_MODE=paper

# Starting budget in account currency (EUR for Trade Republic).
# Paper default is 100 so flat ~1 EUR fees don't dominate P&L.
LMTRADE_BUDGET=100

# Comma-separated instruments to watch (ISINs for TR, tickers for Yahoo Finance)
LMTRADE_UNIVERSE=AAPL,MSFT,SPY

# ---- Model layer ------------------------------------------------------------
# Order the fusion engine consults providers. Any of: heuristic,slm,cloud,perplexity
LMTRADE_MODEL_STACK=heuristic,slm,perplexity

# Local SLM via Ollama (runs on the Vast.ai GPU box)
OLLAMA_HOST=http://localhost:11434
LMTRADE_SLM_MODEL=qwen2.5:1.5b

# Cloud LLM (optional)
ANTHROPIC_API_KEY=
LMTRADE_CLOUD_MODEL=claude-haiku-4-5-20251001

# Perplexity research
PERPLEXITY_API_KEY=
LMTRADE_PERPLEXITY_MODEL=sonar

# ---- Economics / self-sustaining loop ---------------------------------------
# Hourly GPU cost of the Vast.ai instance (USD/hr). The bot halts inference and
# trading when its projected runway drops below the safety floor.
LMTRADE_GPU_USD_PER_HOUR=0.20
# Halt trading if (cash + equity - fees) falls below this many hours of runway
LMTRADE_MIN_RUNWAY_HOURS=6

# ---- Trade Republic (only needed for LMTRADE_MODE=live) ---------------------
TR_PHONE=            # +49...
TR_PIN=              # 4-digit app PIN
TR_LOCALE=en

# ---- Vast.ai deploy (optional) ----------------------------------------------
VAST_API_KEY=

# ---- Web dashboard ----------------------------------------------------------
LMTRADE_WEB_HOST=0.0.0.0
LMTRADE_WEB_PORT=8000
